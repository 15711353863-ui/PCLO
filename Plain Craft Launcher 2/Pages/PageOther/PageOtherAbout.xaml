<local:MyPageRight x:Class="PageOtherAbout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="Plain Craft Launcher Open" Margin="0,0,0,15">
                <StackPanel Margin="21,42,21,18">
                    <TextBlock Margin="0,0,0,9"><Run Text="原作者：龙腾猫跃 · " /><Hyperlink x:Name="LinkOriginalSponsor" NavigateUri="https://meloong.com/afd/a/LTCat?tab=feed">赞助原作者</Hyperlink></TextBlock>
                    <TextBlock Text="Plain Craft Launcher Open 是基于 Plain Craft Launcher 源码开发的开源衍生版。" TextWrapping="Wrap" Margin="0,0,0,9" />
                    <TextBlock Text="当前版本：本地预览 0.3.3。PCLO 是项目简称，O 代表 Open。" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="许可与鸣谢" Margin="0,0,0,15">
                <StackPanel Margin="21,42,21,18">
                    <TextBlock Text="感谢 PCL 原作者及上游贡献者。本项目保留原版源码的许可与署名；独立新增文件的许可见随程序提供的 LICENSING.md 和 THIRD-PARTY-NOTICES.md。" TextWrapping="Wrap" Margin="0,0,0,9" />
                    <TextBlock Text="Minecraft、Microsoft、Modrinth、CurseForge 等名称属于各自权利人。本启动器是独立衍生项目。" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
